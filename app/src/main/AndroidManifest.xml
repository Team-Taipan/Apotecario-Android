<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.apotecario"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Apotecario"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".CadastrarMedicamentoActivity"
            android:exported="false" />
        <activity
            android:name=".NovoPerfilActivity"
            android:exported="false" />
        <activity
            android:name=".GerenciarPerfilActivity"
            android:exported="false" />
        <activity
            android:name=".EstoqueMedicamentoActivity"
            android:exported="false" />
        <activity
            android:name=".InformacaoTratamentoActivity"
            android:exported="false" />
        <activity
            android:name=".FrequenciaMedicamentoActivity"
            android:exported="false" />
        <activity
            android:name=".BuscaMedicamentoActivity"
            android:exported="false" />
        <activity
            android:name=".CriarPerfilActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".RegistroActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>