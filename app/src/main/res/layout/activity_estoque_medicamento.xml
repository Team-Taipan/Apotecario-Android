<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFA"
    tools:context=".EstoqueMedicamentoActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSalvar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:rotation="180"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#1A1C1E" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="48dp"
                android:fontFamily="@font/inter_bold"
                android:text="Estoque de Medicamentos"
                android:textAlignment="center"
                android:textColor="#2D7A6E"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="32dp"
                android:fontFamily="@font/inter"
                android:text="Registre informações sobre seu estoque para não interromper o tratamento"
                android:textAlignment="center"
                android:textColor="#74777F"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/inter_bold"
                android:text="Seu estoque atual"
                android:textColor="#1A1C1E"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/llEstoqueAtual"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_edittext"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMenosEstoque"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_button_side_left"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvEstoqueAtual"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:text="20"
                    android:textColor="#1A1C1E"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/btnMaisEstoque"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_button_side_right"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="Deseja ser avisado quando o estoque estiver baixo?"
                    android:textColor="#74777F"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAviso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#2D7A6E"
                    app:trackTint="#C8E3E0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llQuantidadeMinimaSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Quantidade Mínima"
                    android:textColor="#1A1C1E"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="32dp"
                    android:background="@drawable/bg_edittext"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMenosMinimo"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_button_side_left"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvQuantidadeMinima"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="#1A1C1E"
                        android:textSize="20sp" />

                    <ImageButton
                        android:id="@+id/btnMaisMinimo"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_button_side_right"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnSalvar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#2D7A6E"
        android:fontFamily="@font/inter_bold"
        android:text="Salvar"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>